# Copy this file to ".env" (same folder) and fill in your own values.
# Never share .env, paste it into chat, or commit it to version control.

# ---- OpenAI (leave empty to run in demo mode) ----
# Create a key at https://platform.openai.com/api-keys (needs API billing; a ChatGPT subscription doesn't cover it).
OPENAI_API_KEY=

# Set to 1 to force demo mode even when a key is present.
KINORA_FORCE_DEMO=0

# ---- Models (checked against OpenAI docs, October 2026) ----
KINORA_CHAT_MODEL=gpt-6-luna
# none | low | medium | high. "none" gives the fastest replies. Leave empty for models without reasoning settings.
KINORA_CHAT_REASONING_EFFORT=none
KINORA_TRANSCRIBE_MODEL=gpt-transcribe
KINORA_TTS_MODEL=gpt-4o-mini-tts
KINORA_REQUEST_TIMEOUT_SECONDS=30

# ---- Size and session limits ----
KINORA_MAX_MESSAGE_CHARS=2000
KINORA_MAX_AUDIO_BYTES=5000000
KINORA_MAX_RECORDING_SECONDS=60
KINORA_MAX_TURNS_PER_SESSION=40
KINORA_CONTEXT_MESSAGES=30
KINORA_SESSION_IDLE_MINUTES=60
KINORA_MAX_ACTIVE_SESSIONS=200
KINORA_RATE_LIMIT_PER_MINUTE=20

# ---- Daily allowances (enforced by the app; reset at midnight UTC) ----
# Per browser:
KINORA_CLIENT_DAILY_REPLIES=60
KINORA_CLIENT_DAILY_AUDIO_SECONDS=900
KINORA_CLIENT_DAILY_TTS_CHARS=30000
# Whole app:
KINORA_GLOBAL_DAILY_REPLIES=300
KINORA_GLOBAL_DAILY_AUDIO_SECONDS=3600
KINORA_GLOBAL_DAILY_TTS_CHARS=150000
# Show a warning when this fraction of an allowance is used.
KINORA_WARN_AT_FRACTION=0.8

# ---- Optional cost estimate (USD) for /api/admin/usage ----
# Copy current prices from https://openai.com/api/pricing. 0 = not configured.
# gpt-6-luna was listed at $0.10 input / $0.50 output per 1M tokens in October 2026. Verify before relying on it.
KINORA_PRICE_INPUT_PER_MILLION=0
KINORA_PRICE_OUTPUT_PER_MILLION=0
KINORA_PRICE_TRANSCRIBE_PER_MINUTE=0
KINORA_PRICE_TTS_PER_MILLION_CHARS=0
